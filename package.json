{
  "name": "bplus-tree-database",
  "version": "2.0.0",
  "description": "A high-performance JavaScript database with B+ tree indexing for superior range query performance",
  "main": "v1/lib/index.js",
  "type": "commonjs",
  "bin": {
    "db": "./v1/bin/db",
    "db-server": "./v1/bin/db-server",
    "database-cli": "./v1/cli/database-cli.js"
  },
  "scripts": {
    "start": "node v1/cli/database-cli.js",
    "repl": "node v1/cli/database-cli.js",
    "server": "node v1/bin/db-server",
    "test": "npm run test:v1 && npm run test:v2",
    "test:v1": "node v1/test/bplus-tree.test.js && node v1/test/schema.test.js",
    "test:v1:bplus": "node v1/test/bplus-tree.test.js",
    "test:v1:btree": "node v1/test/table.test.js",
    "test:v2": "node v2/test/schema.test.js && node v2/test/bplus-tree.test.js && node v2/test/table.test.js && node v2/test/integration.test.js",
    "test:v2:schema": "node v2/test/schema.test.js",
    "test:v2:bplus": "node v2/test/bplus-tree.test.js",
    "test:v2:table": "node v2/test/table.test.js",
    "test:v2:integration": "node v2/test/integration.test.js",
    "demo:v1": "node v1/examples-legacy/bplus-tree-demo.js",
    "demo:v1:btree": "node v1/examples-legacy/table-crud.js",
    "demo:v1:bplus": "node v1/examples-legacy/bplus-tree-demo.js",
    "demo:v1:optimized": "node v1/examples-legacy/optimized-demo.js",
    "demo:v1:socket": "node v1/examples/socket-basic.js",
    "demo:v1:socket-auth": "node v1/examples/socket-auth.js",
    "demo:v1:socket-perf": "node v1/examples/socket-performance.js",
    "benchmark:v1": "node v1/examples-legacy/bplus-tree-demo.js",
    "benchmark:v1:performance": "node v1/benchmarks/performance-comparison.js",
    "benchmark:v1:compare": "node v1/benchmarks/performance-comparison.js",
    "docs": "echo 'Documentation available in v1/docs/ and v2/README.md'",
    "clean": "rm -rf data/ test-data/ *.db benchmark-data/",
    "install-global": "npm install -g .",
    "lint": "echo 'No linting configured'",
    "format": "echo 'No formatting configured'"
  },
  "keywords": [
    "database",
    "btree",
    "bplus-tree",
    "javascript",
    "indexing",
    "range-queries",
    "performance",
    "storage",
    "nosql",
    "embedded"
  ],
  "author": "Database Development Team",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/username/bplus-tree-database.git"
  },
  "bugs": {
    "url": "https://github.com/username/bplus-tree-database/issues"
  },
  "homepage": "https://github.com/username/bplus-tree-database#readme",
  "directories": {
    "lib": "v1/lib",
    "test": "v1/test",
    "doc": "v1/docs"
  },
  "files": [
    "v1/",
    "v2/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {},
  "dependencies": {},
  "peerDependencies": {},
  "optionalDependencies": {},
  "config": {
    "database": {
      "defaultIndexType": "bplus",
      "defaultDataDir": "./data",
      "pageSize": 4096,
      "cacheSize": 100
    }
  }
}